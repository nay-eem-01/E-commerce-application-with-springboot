# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Staging/production set the same names as real environment variables.

SPRING_PROFILES_ACTIVE=development

# --- database (PostgreSQL 15+, 16 and 17 fine; NULLS NOT DISTINCT is used) ---
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=
DB_PASSWORD=

# --- JWT ---
# Base64, at least 64 bytes decoded (HS512). Generate with:
#   openssl rand -base64 64
JWT_SECRET=

# --- CORS --- comma-separated browser origins. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- first admin (optional) ---
# Created at startup only when no admin exists. Leave the password empty to have one
# generated and printed once in the log. The admin must change it on first sign-in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- SMS --- "console" logs codes and works only in the development profile.
SMS_PROVIDER=console

# --- payments ---
# What checkout offers (COD always works). Add BKASH, NAGAD, CARD once their vendor has credentials.
PAYMENT_ENABLED_METHODS=COD
# Vendor per method: bkash | sslcommerz | fake (development only). Switching vendor = changing this.
PAYMENT_ROUTE_BKASH=bkash
PAYMENT_ROUTE_NAGAD=sslcommerz
PAYMENT_ROUTE_CARD=sslcommerz
# Storefront page shoppers land on after paying.
PAYMENT_RETURN_URL=http://localhost:5173/checkout/result

# bKash tokenized checkout (merchant portal). Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# SSLCommerz store. Sandbox: https://sandbox.sslcommerz.com  Live: https://securepay.sslcommerz.com
SSLCOMMERZ_BASE_URL=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# Used when a guest gives no email (SSLCommerz requires one).
SSLCOMMERZ_FALLBACK_EMAIL=

# --- email (order notifications) ---
# smtp | log. "log" writes emails to the log instead of sending them.
MAIL_PROVIDER=log
MAIL_FROM=Senpai Supply <orders@example.com>
MAIL_BRAND_NAME=Senpai Supply
# Storefront base URL used in email links (/track, /orders/{number}).
STOREFRONT_URL=http://localhost:5173
# Optional: gets a copy of every new order.
MAIL_STAFF_ADDRESS=
# SMTP (when MAIL_PROVIDER=smtp). Set MAIL_SMTP_AUTH=false for a relay without credentials.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- production ---
# Public URL of this API: Swagger server and payment callback base.
APP_BASE_URL=http://localhost:8080
# Set to "native" behind a reverse proxy that sets X-Forwarded-For (production sets it).
FORWARD_HEADERS_STRATEGY=none
